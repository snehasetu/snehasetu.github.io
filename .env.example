# Copy this file to .env and fill in your values. Never commit .env.

# Supabase PostgreSQL (from Dashboard → Settings → Database → Connection string → URI, use "Connection pooling")
DATABASE_URL=postgresql://postgres.[ref]:[YOUR-PASSWORD]@aws-1-ap-northeast-1.pooler.supabase.com:5432/postgres

# Supabase auth (from Dashboard → Settings → API)
VITE_SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Optional: when frontend is on a different origin (e.g. GitHub Pages)
# VITE_API_URL=https://your-api.example.com
# API_URL=https://your-api.example.com

PORT=5000
